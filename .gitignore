# Generated by Cargo
# will have compiled files and executables
debug/
target/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# macOS puts these everywhere
.DS_Store

# neovim project specific settings
.nvimrc

# vscode project specific settings
.vscode/

# transcript
*.json

# package manifests for the wasm package-contract test harness
!/crates/wasm/tests/contract/package.json
!/crates/wasm/tests/contract/package-lock.json
!/crates/wasm/tests/contract/tsconfig.json

# env var
*.env

# logs
*.log

# metrics
*.csv
